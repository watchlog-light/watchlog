{
  "name": "@watchlog/backend",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "NODE_ENV=development tsx watch src/alert-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/alert-worker.js",
    "migrate": "tsx src/migrate.ts",
    "rotate-secret-key": "tsx src/rotate-secret-key.ts",
    "cli": "tsx src/cli.ts",
    "db:codegen": "kysely-codegen --dialect postgres --exclude-pattern pgmigrations --out-file src/db/types.ts && prettier --write src/db/types.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "openapi:snapshot": "tsx scripts/openapi-snapshot.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@node-rs/argon2": "^2.2.2",
    "@watchlog/cause-words": "workspace:*",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "snappy": "^7.4.3",
    "typebox": "^1.4.3",
    "undici": "^8.12.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
