HOST=127.0.0.1
PORT=4080
LOG_LEVEL=info
# Required outside development (deploy/docker/compose.dev.yaml in development):
DATABASE_URL=postgres://watchlog:watchlog@localhost:54320/watchlog
# Public origin of the web app, if it differs from the backend's Host header (CSRF check, ADR-034):
# WATCHLOG_PUBLIC_URL=https://watchlog.example.com
# Trust X-Forwarded-* from a reverse proxy (needed for Secure cookies behind TLS termination):
# WATCHLOG_TRUST_PROXY=true
# Create the admin at startup instead of using the setup code (ADR-032):
# WATCHLOG_ADMIN_EMAIL=admin@example.com
# WATCHLOG_ADMIN_PASSWORD=change-me-please
# Used from later Phase 1 slices on:
VICTORIAMETRICS_URL=http://localhost:8428
REDIS_URL=redis://localhost:63790
