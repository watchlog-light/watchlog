# Web image (ADR-014): serves the SPA and, in the Community compose stack, proxies
# the API, the MCP server and agent ingest to the backend so one port serves browsers,
# AI assistants and agents.
# WATCHLOG_BACKEND defaults to the compose service name.
{
	admin off
	auto_https off
	# A TLS proxy in front (nginx, an ingress) on a private network says the visitor came
	# over https: X-Forwarded-Proto passes through, and the backend marks the session
	# cookie Secure (ADR-123). Without this Caddy would overwrite it with http.
	servers {
		trusted_proxies static private_ranges
	}
}

# The dashboard's response headers per edition (ADR-181). WATCHLOG_EDITION=cloud on the web
# container turns on Cloud's strict Content-Security-Policy and the other headers for the
# dashboard's own files; Community (unset) sends none of them, as before. The API's headers
# come from the backend; HSTS is the TLS proxy's (nginx in Cloud). The policy is the one in
# backend/src/lib/csp.ts (a test keeps the two the same).
(edition-community) {
}
(edition-cloud) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

:8080 {
	encode zstd gzip

	handle /api/* {
		# X-Forwarded-For stays Caddy's own peer, as without trusted_proxies: a client must
		# not name its own address (Caddy calls this header_up unnecessary; measured, it is
		# not). The visitor's address for rate limits comes from WATCHLOG_CLIENT_IP_HEADER.
		reverse_proxy {$WATCHLOG_BACKEND:backend:4080} {
			header_up X-Forwarded-For {remote_host}
		}
	}
	# The MCP server (ADR-127): AI assistants connect to <public address>/mcp. Streamed
	# (SSE) answers go out as they come.
	handle /mcp {
		reverse_proxy {$WATCHLOG_BACKEND:backend:4080} {
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}
	# MCP clients look for OAuth metadata when a token is refused. WatchLog uses bearer
	# tokens (no OAuth yet, ADR-127): answer 404, not the dashboard's HTML.
	handle /.well-known/oauth-* {
		respond 404
	}
	handle /.well-known/openid-configuration* {
		respond 404
	}
	handle /ingest/* {
		request_body {
			max_size 8MB
		}
		# As for /api: X-Forwarded-For is Caddy's own peer.
		reverse_proxy {$WATCHLOG_BACKEND:backend:4080} {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		import edition-{$WATCHLOG_EDITION:community}
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
