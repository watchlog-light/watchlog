# Required: password for the bundled PostgreSQL.
WATCHLOG_DB_PASSWORD=
# Required: key for alert channel secrets, created once with `openssl rand -base64 32`.
# Back it up together with the database: without it stored channel secrets are lost,
# and the backend refuses to start with a different key.
WATCHLOG_SECRET_KEY=
# The URL agents and browsers use to reach this server, e.g. http://10.0.0.5:8080
WATCHLOG_PUBLIC_URL=
# Optional
# Email alerts: one SMTP server, e.g. smtp://user:password@smtp.example.com:587
# WATCHLOG_SMTP_URL=
# WATCHLOG_SMTP_FROM=WatchLog <alerts@example.com>
# Outbound proxy for Slack, Telegram and webhook alerts (Telegram is blocked on some networks):
# HTTPS_PROXY=
# NO_PROXY=
# WATCHLOG_PORT=8080
# WATCHLOG_RETENTION=15d
# WATCHLOG_VERSION=latest
# Create the admin at startup instead of using the setup code from the backend log:
# WATCHLOG_ADMIN_EMAIL=
# WATCHLOG_ADMIN_PASSWORD=
# If gcr.io is unreachable when building from source (compose.build.yaml):
# BACKEND_RUNTIME_IMAGE=node:24-bookworm-slim
